# =====================================================================
# Contoh variabel lingkungan. Salin jadi `.env.local` lalu isi nilainya.
# Berkas `.env.local` TIDAK PERNAH masuk ke repo.
# =====================================================================

# --- Basis data -------------------------------------------------------
# Postgres lewat Neon di Vercel Marketplace.
# Pakai connection string yang BER-POOLER (host-nya mengandung "-pooler"),
# karena aplikasi ini jalan di serverless dan membuka koneksi berkali-kali.
# Contoh Neon:
#   postgresql://user:pass@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Contoh Postgres lokal untuk pengembangan:
#   postgresql://hh:hh@localhost:5432/hh
DATABASE_URL=

# --- Autentikasi staf (owner / recruiter) -----------------------------
# Kunci acak untuk menandatangani cookie sesi. Buat dengan:
#   openssl rand -base64 32
AUTH_SECRET=

# Alamat aplikasi. Di Vercel biasanya terisi otomatis; isi untuk lokal.
NEXTAUTH_URL=http://localhost:3000

# --- Akun owner pertama (dipakai oleh `npm run db:seed`) --------------
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=

# --- Identitas perusahaan (dipakai oleh `npm run db:seed`) ------------
# Muncul di kop tagihan. Boleh dikosongkan dulu, bisa diubah nanti.
COMPANY_LEGAL_NAME=
