# =====================================================================
# Contoh variabel lingkungan. Salin jadi `.env.local` lalu isi nilainya.
# Berkas `.env.local` TIDAK PERNAH masuk ke repo.
# =====================================================================

# --- Basis data -------------------------------------------------------
# Di Vercel, ini terisi sendiri saat Neon dipasang lewat tab Storage.
# Sistem juga menerima nama POSTGRES_URL, DATABASE_URL_UNPOOLED, atau
# POSTGRES_URL_NON_POOLING — tergantung nama yang dipakai integrasi Neon.
#
# Postgres lewat Neon di Vercel Marketplace.
# Pakai connection string yang BER-POOLER (host-nya mengandung "-pooler"),
# karena aplikasi ini jalan di serverless dan membuka koneksi berkali-kali.
# Contoh Neon:
#   postgresql://user:pass@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Contoh Postgres lokal untuk pengembangan:
#   postgresql://hh:hh@localhost:5432/hh
DATABASE_URL=

# --- Autentikasi staf (owner / recruiter) -----------------------------
# Kunci acak untuk menandatangani cookie sesi. Buat dengan:
#   openssl rand -base64 32
AUTH_SECRET=

# Alamat aplikasi. Di Vercel biasanya terisi otomatis; isi untuk lokal.
NEXTAUTH_URL=http://localhost:3000

# --- Penyimpanan berkas (CV dan dokumen kandidat) ---------------------
# Tambahkan Vercel Blob di proyek Vercel Anda; nilainya terisi otomatis di sana.
# Bila dikosongkan, seluruh sistem tetap jalan — hanya unggah CV yang belum bisa,
# dan pesannya muncul jelas di layar, bukan berupa halaman rusak.
BLOB_READ_WRITE_TOKEN=

# --- Basis data terpisah untuk `npm run db:test-rules` ----------------
# Perintah itu MENGOSONGKAN basis data sasaran, jadi ia menolak jalan ke basis
# data produksi. Isi ini, atau arahkan DATABASE_URL ke Postgres di komputer sendiri.
TEST_DATABASE_URL=

# --- Akun owner pertama (dipakai oleh `npm run db:seed`) --------------
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=

# --- Identitas perusahaan (dipakai oleh `npm run db:seed`) ------------
# Muncul di kop tagihan. Boleh dikosongkan dulu, bisa diubah nanti.
COMPANY_LEGAL_NAME=
